# --- Google Sheets / Drive (the data store — see README for full setup) ---
# The ID from the Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS>/edit
# Defaults to the existing "Kenzen Payment Desk – Data" sheet from the Apps Script version.
GOOGLE_SHEET_ID=1_8ix-jc6U2-TUrFvagGKmp9MIQQxQr0NiZzaq2_KGX8
# The Drive folder ID that holds the "Invoices" and "Excel logs" subfolders.
# Defaults to the existing "Kenzen Payment Desk" folder — this folder must
# live inside a Shared Drive for uploads/exports to work (see README §1.3);
# service accounts have no storage of their own in a regular "My Drive".
GOOGLE_DRIVE_ROOT_FOLDER_ID=1e9lIWVV2Q5C0Rx3MNIAvxN8E9BnQlWCU
# The full service-account JSON key, base64-encoded (see README §1.2). Either
# the raw JSON or the base64 of it is accepted.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Leave this BLANK if you moved the Drive folder into a Shared Drive (README
# §1.3, the default approach) — the service account acts as itself, which is
# fine once it's a Shared Drive member. Only set this (to the Sheet/folder
# owner's email) if you used the domain-wide delegation alternative instead.
GOOGLE_IMPERSONATE_EMAIL=

# --- Auth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized JavaScript origin: your Vercel URL (and http://localhost:5173 for local dev)
GOOGLE_CLIENT_ID=
# Same value as GOOGLE_CLIENT_ID above — the frontend bundle needs it too
VITE_GOOGLE_CLIENT_ID=
# Only emails on this domain can sign in
ALLOWED_DOMAIN=kenzenventures.com
# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`
JWT_SECRET=
# This email is always treated as admin, even before any roles are configured (first-run bootstrap)
OWNER_EMAIL=accounts@kenzenventures.com

# --- Optional: AI invoice reading (toggle lives in Approvals & settings, admin-only) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Optional: only used if you re-enable the daily export cron in vercel.json ---
CRON_SECRET=
